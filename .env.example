# Copie para .env e preencha com valores do SEU ambiente.
# Este arquivo apenas documenta as variáveis usadas pelo projeto — nunca contém valores reais.
#
# Usado pelo base/docker-compose.yml (desenvolvimento). Se ausente, o compose usa os defaults
# dev-only (desafio/desafio); criar um .env permite sobrescrever sem alterar o compose.

POSTGRES_DB=desafio
POSTGRES_USER=desafio
POSTGRES_PASSWORD=change_me

# Connection string usada pela API (runtime e dotnet-ef). A chave em formato __ é como o
# ASP.NET Core lê ConnectionStrings:Postgres a partir de variável de ambiente.
ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=desafio;Username=desafio;Password=change_me